{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"bunVersion": "1.x",
	"installCommand": "bun install && cd src/client && bun install",
	"buildCommand": "bun run build",
	"outputDirectory": "src/client/dist",
	"rewrites": [
		{
			"source": "/api/(.*)",
			"destination": "/api/index"
		},
		{
			"source": "/((?!api/).*)",
			"destination": "/index.html"
		}
	]
}
